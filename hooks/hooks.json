{
  "claude-mem": {
    "SessionStart": [
      {
        "type": "command",
        "command": "if [ \"${AGY_INTERNAL_OBSERVER:-0}\" = \"1\" ]; then printf \"{}\\n\"; exit 0; fi; /usr/bin/python3 \"$HOME/.gemini/config/hooks/claude_mem_hook_gate.py\" context",
        "timeout": 30
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "if [ \"${AGY_INTERNAL_OBSERVER:-0}\" = \"1\" ]; then printf \"{}\\n\"; exit 0; fi; /usr/bin/python3 \"$HOME/.gemini/config/hooks/claude_mem_hook_gate.py\" session-init",
        "timeout": 30
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "if [ \"${AGY_INTERNAL_OBSERVER:-0}\" = \"1\" ]; then printf \"{}\\n\"; exit 0; fi; /usr/bin/python3 \"$HOME/.gemini/config/hooks/claude_mem_hook_gate.py\" summarize",
        "timeout": 30
      }
    ]
  },
  "post-compact-rehydrate": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "if [ \"${AGY_INTERNAL_OBSERVER:-0}\" = \"1\" ]; then printf \"{}\\n\"; exit 0; fi; /usr/bin/python3 \"$HOME/.gemini/config/hooks/rehydrate_after_compact.py\"",
        "timeout": 15
      }
    ]
  },
  "taint-outbound-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|call_mcp_tool|write_file|edit_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$HOME/.gemini/config/hooks/taint_outbound_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "bot-isolation-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "read_file|view_file|list_dir|find_by_name|grep_search|write_file|edit_file|replace_file_content|multi_replace_file_content|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$HOME/.gemini/config/hooks/bot_isolation_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
