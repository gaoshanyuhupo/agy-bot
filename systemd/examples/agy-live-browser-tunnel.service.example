[Unit]
Description=Cloudflare Tunnel for AGY Live Browser (live.your-domain.com)
After=network-online.target agy-live-browser.service
Wants=network-online.target

[Service]
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/agy-workspace
Environment=HOME=/home/YOUR_USER
Environment=AGY_INTERNAL_OBSERVER=1
EnvironmentFile=-/home/YOUR_USER/.config/agy-live-browser/tunnel.env
ExecStart=/home/YOUR_USER/agy-workspace/.agents/skills/live-browser/scripts/run_tunnel.sh
Restart=always
RestartSec=5
KillMode=process
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
