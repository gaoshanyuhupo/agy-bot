[Unit]
Description=Antigravity CLI Bot GitHub Webhook Receiver (HMAC-SHA256)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/agy-tg-bridge
Environment=AGY_BOT_BUS_DIR=/home/YOUR_USER/.gemini/antigravity-cli/bot-bus
Environment=AGY_GH_WEBHOOK_SECRET_BAO_REF=REPLACE_WITH_BAO_SECRET_PATH
Environment=AGY_GH_WEBHOOK_SECRET_BAO_FIELD=secret
Environment=AGY_GH_WEBHOOK_ALLOWED_REPOS=YOUR_ORG/YOUR_REPO
Environment=AGY_GH_WEBHOOK_NOTIFY_BOT=@your_bot
EnvironmentFile=-/home/YOUR_USER/agy-tg-bridge/.env
ExecStart=/home/YOUR_USER/agy-tg-bridge/venv/bin/python /home/YOUR_USER/agy-tg-bridge/github_webhook.py --host 127.0.0.1 --port 18798 --path /webhook
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/YOUR_USER/.gemini/antigravity-cli/bot-bus

[Install]
WantedBy=multi-user.target
