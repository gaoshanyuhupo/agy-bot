[Unit]
Description=Antigravity CLI Local OpenAI-Compatible Observer Shim
After=network.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/agy-mem-hub
Environment=PATH=/home/YOUR_USER/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=AGY_SHIM_MODEL=gemini-3.8-flash-low
Environment=AGY_INTERNAL_OBSERVER=1
Environment=ECC_SKIP_OBSERVE=1
ExecStart=/home/YOUR_USER/agy-tg-bridge/venv/bin/python /home/YOUR_USER/agy-mem-hub/agy_llm_shim.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
