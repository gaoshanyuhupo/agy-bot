# Antigravity CLI Telegram Bridge v3 Configuration (.env / .env.sg)
# Copy to $HOME/agy-tg-bridge/.env (chmod 0600) — NEVER commit real tokens.

AGY_TG_BOT_TOKEN=1234567890:REPLACE_WITH_TELEGRAM_BOT_TOKEN
AGY_TG_ALLOWED_CHATS=123456789
AGY_TG_WORKDIR=$HOME/agy-workspace
AGY_TG_AGY_BIN=$HOME/.local/bin/agy
AGY_TG_STATE_FILE=$HOME/.agy-tg-bridge-state.json
AGY_TG_RELOAD_FILE=/tmp/agy_bridge_reload
AGY_TG_PRINT_TIMEOUT=30m
AGY_TG_IDLE_TTL=2700
AGY_TG_AUTO_COMPACT_TOKENS=180000

# Optional Coordinator Bot Bus role/specialization overrides (also editable live via Telegram /team)
# AGY_TG_BOT_ROLE=coordinator   # coordinator | worker | peer
# AGY_TG_BOT_MODEL=gemini-3.8-flash-low
# AGY_TG_BOT_PROJECT=
# AGY_TG_BOT_SPECIALTY=
# AGY_BUS_CHAT_MODE=conversational   # conversational | card
# AGY_BUS_FAST_CHAT=1                # 1=allow read-only fast group replies while worker is busy; 0=strict serial queue

# Optional Whisper-compatible Speech-to-Text endpoint for voice messages
AGY_TG_STT_BASE=
AGY_TG_STT_KEY=
AGY_TG_STT_MODEL=whisper-1
