# Antigravity CLI Telegram Bridge v3 Configuration (.env / .env.sg)
# Copy to $HOME/agy-tg-bridge/.env (chmod 0600) — NEVER commit real tokens.

AGY_TG_BOT_TOKEN=1234567890:REPLACE_WITH_TELEGRAM_BOT_TOKEN
AGY_TG_ALLOWED_CHATS=123456789
AGY_TG_WORKDIR=$HOME/agy-workspace
AGY_TG_AGY_BIN=$HOME/.local/bin/agy
AGY_TG_STATE_FILE=$HOME/.agy-tg-bridge-state.json
AGY_TG_RELOAD_FILE=/tmp/agy_bridge_reload
AGY_TG_PRINT_TIMEOUT=30m
AGY_TG_IDLE_TTL=2700
AGY_TG_AUTO_COMPACT_TOKENS=180000

# Optional Coordinator Bot Bus role/specialization overrides (also editable live via Telegram /team)
# AGY_TG_BOT_ROLE=coordinator   # coordinator | worker | peer
# AGY_TG_BOT_MODEL=gemini-3.8-flash-low
# AGY_TG_BOT_EFFORT=
# AGY_TG_FALLBACK_MODELS=gemini-3.8-flash-high,claude-sonnet-5-5
# AGY_TG_BOT_PROJECT=
# AGY_TG_BOT_SPECIALTY=
# AGY_BUS_CHAT_MODE=conversational   # conversational | card
# AGY_BUS_FAST_CHAT=1                # 1=allow read-only fast group replies while worker is busy; 0=strict serial queue

# Optional Multi-Gateway Adapter Configuration (`bridge/gateway_adapter.py`)
# Store real API keys in OpenBao (`api_key_cmd`) or environment (`api_key_env`), NEVER commit secrets.
# AGY_TG_GATEWAYS_FILE=$HOME/.config/agy-tg-bridge/gateways.json
# AGY_TG_GATEWAYS_JSON=[{"id":"example_gw","name":"Example GW","base_url":"http://127.0.0.1:8317/v1","dialect":"cpa","api_key_env":"EXAMPLE_GW_API_KEY","enabled":true}]

# Optional Group/User RBAC (leave unset for legacy AGY_TG_ALLOWED_USERS full-admin behavior)
# AGY_TG_ADMIN_USERS=123456789
# AGY_TG_READONLY_USERS=
# AGY_TG_ALLOW_GROUP_READONLY=0      # 1=non-admin members in allowed groups get readonly Q&A access

# Optional Whisper-compatible Speech-to-Text endpoint for voice messages
AGY_TG_STT_BASE=
AGY_TG_STT_KEY=
AGY_TG_STT_MODEL=whisper-1

# Optional Fail-Closed GitHub Webhook Receiver (`bridge/github_webhook.py`)
# AGY_GH_WEBHOOK_HOST=127.0.0.1
# AGY_GH_WEBHOOK_PORT=18798
# AGY_GH_WEBHOOK_PATH=/webhook
# AGY_GH_WEBHOOK_SECRET=REPLACE_WITH_GITHUB_WEBHOOK_SECRET
# AGY_GH_WEBHOOK_SECRET_FILE=
# AGY_GH_WEBHOOK_SECRET_BAO_REF=REPLACE_WITH_BAO_SECRET_PATH
# AGY_GH_WEBHOOK_SECRET_BAO_FIELD=secret
# AGY_GH_WEBHOOK_ALLOWED_REPOS=YOUR_ORG/YOUR_REPO
# AGY_GH_WEBHOOK_EVENTS=issues,issue_comment,pull_request,pull_request_review,pull_request_review_comment,release,workflow_run
# AGY_GH_WEBHOOK_NOTIFY_BOT=@your_bot
# AGY_GH_WEBHOOK_CHAT_ID=-1001234567890
# AGY_GH_WEBHOOK_THREAD_ID=
