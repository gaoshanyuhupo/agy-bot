# Telegram Bot Configuration
AGY_SDK_BOT_TOKEN=your_new_telegram_bot_token_here
AGY_SDK_ALLOWED_CHATS=123456789

# Gemini / Model Authentication
# Obtain a Gemini API Key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Default model (e.g. gemini-2.5-pro, gemini-2.5-flash)
# Default is gemini-3.8-flash if omitted
# AGY_SDK_MODEL=gemini-2.5-pro

# Workspace Directory
AGY_SDK_WORKDIR=$HOME/agy-workspace
